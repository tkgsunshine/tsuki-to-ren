{
  "outputDirectory": "dist",
  "functions": {
    "api/column-og.js": {
      "includeFiles": "{scripts/x/assets/ShipporiMincho-Bold.ttf,scripts/x/assets/emblem.png,scripts/column-ogp/bg/*.jpg,src/data/columnsData.ts,node_modules/@resvg/resvg-wasm/index_bg.wasm}"
    },
    "api/admin.js": {
      "includeFiles": "{data/x/followers.json,data/x/queue.json}"
    },
    "api/og.js": {
      "includeFiles": "{scripts/x/assets/ShipporiMincho-Bold.ttf,scripts/x/assets/emblem.png,node_modules/@resvg/resvg-wasm/index_bg.wasm,public/assets/astrology_*.jpg,public/assets/tsuki.jpg,public/assets/ren.jpg}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-luck",
      "schedule": "0 23 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/column/infp-entj-polar-attraction-chemistry",
      "destination": "/column/infp-entj-contrast-relationship",
      "permanent": true
    },
    {
      "source": "/column/enfp-intj-soul-resonance-attraction",
      "destination": "/column/intj-enfp-love-chemistry",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "tsuki-to-ren.com"
        }
      ],
      "destination": "https://www.tsuki-to-ren.com/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://tsuki-to-ren-dba8c.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/share/card",
      "destination": "/api/share"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/fortune",
      "destination": "/index.html"
    },
    {
      "source": "/result",
      "destination": "/index.html"
    },
    {
      "source": "/chat",
      "destination": "/index.html"
    },
    {
      "source": "/mypage",
      "destination": "/index.html"
    },
    {
      "source": "/profile",
      "destination": "/index.html"
    },
    {
      "source": "/column",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/tokushoho",
      "destination": "/index.html"
    },
    {
      "source": "/company",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/tools/nicchu",
      "destination": "/tools/nicchu/index.html"
    },
    {
      "source": "/guardians",
      "destination": "/guardians/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/news",
      "destination": "/index.html"
    },
    {
      "source": "/compatibility",
      "destination": "/index.html"
    },
    {
      "source": "/compatibility/:pair([a-zA-Z]{4}-[a-zA-Z]{4})",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!__/auth/).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/compatibility/:pair([a-zA-Z]{4}-[a-zA-Z]{4})",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/news",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
